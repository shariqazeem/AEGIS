# AEGIS Backend Configuration

# API Settings
API_HOST=0.0.0.0
API_PORT=8000

# Model Settings
VISION_MODEL=vikhyatk/moondream2
REASONING_MODEL=meta-llama/Llama-3.2-3B-Instruct

# Hardware Optimization
USE_MLX=true
DEVICE=mps  # 'mps' for Apple Silicon, 'cuda' for NVIDIA, 'cpu' for fallback

# Vision Settings
CAMERA_INDEX=0
INFERENCE_INTERVAL=2.5  # seconds between AI analysis
VIDEO_QUALITY=85  # JPEG quality (0-100)
FPS_TARGET=30

# Threat Detection
THREAT_KEYWORDS=fire,fallen,falling,blood,weapon,danger,emergency

# Parallax Configuration (will be added after setup)
PARALLAX_NODE_ID=
PARALLAX_NETWORK=

# Logging
LOG_LEVEL=INFO
